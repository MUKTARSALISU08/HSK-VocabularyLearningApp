{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true
  },
  "include": [
    "src/**/*.ts",
    "src/server.ts",
    "src/routes/*.ts",
    "src/controllers/*.ts",
    "src/services/*.ts",
    "src/middleware/*.ts",
    "src/utils/*.ts",
    "src/types/*.ts",
    "src/schemas/*.ts"
  ],
  "exclude": ["node_modules"]
}